TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
APP_MODE=PAPER
MARKET_DATA_PROVIDER=deriv
# Optional - the public Deriv market-data feed needs no API key.
DERIV_API_KEY=
# Optional override (defaults to Deriv's public market-data socket).
# DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public
# Comma-separated Deriv symbols or names. Empty = all mapped Volatility indices.
# e.g. DERIV_ASSETS=R_10,R_25,R_50,R_75,R_100,1HZ10V,1HZ100V
DERIV_ASSETS=R_25
DISPLAY_TIMEZONE=Africa/Lagos
DATABASE_PATH=data/signals.db

# --- Triple EMA Convergence strategy (proposed defaults - backtest them) ---
# Signal timeframe(s): 1m, 2m, 3m, 5m, 10m, 15m or 30m (comma-separated).
SIGNAL_TIMEFRAME=5m
EMA_FAST=7
EMA_MID=14
EMA_SLOW=32
# standard_close (recommended) or heikin_ashi_close
EMA_PRICE_SOURCE=standard_close
# Converged when (max EMA - min EMA) / close * 100 <= MAX_EMA_SPREAD_PCT on
# one of the last CONVERGENCE_LOOKBACK closed candles.
MAX_EMA_SPREAD_PCT=0.10
CONVERGENCE_LOOKBACK=3
# A convergence setup expires after this many closed candles without a BUY.
SETUP_MAX_AGE_CANDLES=8
# Stop-loss = most recent fractal swing low below the entry: a candle whose
# low is lower than SWING_LOOKBACK candles on each side, searched within the
# last SL_SEARCH_CANDLES closed candles.
SWING_LOOKBACK=2
SL_SEARCH_CANDLES=50

# --- Notifications ---
NOTIFY_CONVERGENCE=true
EXECUTION_SIGNAL=true
NOTIFY_INVALIDATIONS=false

# --- MT5 execution (Windows only) ---
# Requires a Deriv MT5 account (create a demo one in the Deriv dashboard) -
# the Deriv API key cannot log in to MT5. With TAKE_TRADE=true each BUY
# signal opens POSITIONS_PER_TRADE market positions managed as one basket.
TAKE_TRADE=false
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: path to terminal64.exe when auto-detect fails.
# MT5_PATH=
# 0 = trade each symbol's minimum lot size (recommended); a value > 0 is a
# fixed lot clamped to each symbol's limits.
MT5_LOT=0
MT5_DEVIATION=30
# Positions opened per BUY signal. Every position's SL sits at the most
# recent swing low; the basket closes when the 32 EMA crosses back above
# both the 14 EMA and the 7 EMA.
POSITIONS_PER_TRADE=5

# Profit target + trailing SL (account currency). The basket's floating
# profit is measured as a % of BASE_AMOUNT: the trade closes at
# PERCENTAGE_PROFIT %. At the first 10% of floating profit each SL moves
# to the 50% level between entry and its initial stop (risk is halved);
# after that every 10% milestone moves the SL to the profit level 10%
# behind (20% -> +10%, 30% -> +20%, ...). 0 disables the feature.
BASE_AMOUNT=0
PERCENTAGE_PROFIT=0
